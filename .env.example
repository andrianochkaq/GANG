# FreeCook environment variables.
# Copy this file to .env and fill in the values. Never commit .env.
# Secrets are left empty here on purpose.

# --- PostgreSQL ---
POSTGRES_DB=freecook
POSTGRES_USER=freecook
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache and Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Django and JWT ---
# Settings module: config.settings.dev (local) or config.settings.prod.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
# Comma-separated lists. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SMTP (email codes) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# --- Twilio (phone codes) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- AI Chef ---
AI_API_KEY=
