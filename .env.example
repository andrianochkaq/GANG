# FreeCook environment variables.
# Copy this file to .env and fill in the values. Never commit .env.
# Secrets are left empty here on purpose.

# --- PostgreSQL ---
POSTGRES_DB=freecook
POSTGRES_USER=freecook
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache and Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Django and JWT ---
# Settings module: config.settings.dev (local) or config.settings.prod.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
# Comma-separated lists. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
# Backend origin the React app calls; empty means the same origin.
VITE_API_URL=http://localhost:8000
# true: the login screens use an in-memory mock instead of /api/auth/
# (until FC-103 … FC-107 land). Mock code: 123456.
VITE_AUTH_MOCK=true

# --- SMTP (email codes) ---
# In Docker Compose development these are overridden to send every email
# to Mailpit (http://localhost:8025). Without SMTP_HOST, the dev settings
# use a local Mailpit on port 1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# --- SMS (phone codes) ---
# Dotted path of the SMS backend class. Empty in development means the
# console backend (codes are printed in the backend log).
SMS_BACKEND=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# The bot's username without "@"; it is used in the t.me login link.
TELEGRAM_BOT_USERNAME=
# Letters, digits, "_" and "-". Telegram sends it back in a header on every
# webhook call; with it empty the webhook refuses everything.
TELEGRAM_WEBHOOK_SECRET=

# --- AI Chef ---
AI_API_KEY=
